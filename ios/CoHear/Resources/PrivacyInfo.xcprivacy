<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for App Store submission. This file is the truth Apple checks
         your nutrition label against. Everything here must match reality. -->

    <!-- We do not track. No ad identifiers, no cross-app data. -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!-- We collect no data. Audio is processed on-device and discarded.
         Transcripts live in memory and are gone when the app closes.
         Settings are on-device only and are not "collected". -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <!-- Required-reason APIs we touch. UserDefaults for two settings. -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- CA92.1: access UserDefaults to read/write app's own settings -->
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
